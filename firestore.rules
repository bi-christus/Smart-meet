rules_version = '2';

// ============================================================================
// Smart Meeting — Regras de segurança do Firestore
//
// Modelo de acesso:
//  - Usuários são identificados pelo e-mail (doc id = e-mail em minúsculas).
//  - Só quem tem doc em /users com active == true (ou o super admin) usa o app.
//  - Papéis: admin > gestor > operador.
//  - O super admin (bootstrap) pode sempre gerenciar — cria o próprio doc no
//    primeiro acesso, resolvendo o problema do "primeiro admin".
//
// O QUE MUDOU (2026-08-03) e por quê:
//  - /cards e /meetings tinham `write: if isAuthorized()`. Qualquer operador
//    ativo apagava TODOS os cards de TODOS os setores pelo console, sem log.
//    Agora leitura e escrita são escopadas por setor, e apagar exige gestor.
//  - `sector` e `createdBy` de um card passam a ser imutáveis: mover card entre
//    setores por update era um jeito de contornar o escopo.
//  - `driveOutputs` e `notifiedAt` das reuniões só o servidor escreve (Admin
//    SDK ignora estas regras). Do cliente, ficam bloqueados — eram o caminho
//    para apagar os links da ata ou reenviar e-mail.
//  - /solicitantes e /solicitanteSetores ganharam regra própria: o app os usa
//    (Kanban lê, Admin gerencia) e a negação final os bloqueava.
//  - /logs deixa de aceitar escrita do cliente — auditoria forjável não serve
//    como auditoria. Quem grava é o servidor.
//
// O QUE MUDOU (2026-08-07):
//  - /recorrencias e /ocorrencias, da aba Recorrências. A regra é escopada por
//    setor e editável por gestor; a ocorrência (a data que já virou card) é
//    somente leitura no cliente, porque quem a cria é a rota de geração, numa
//    transação que garante um card por data prevista.
//
// O QUE MUDOU (2026-08-12):
//  - /cards/{id}/historico, a trilha de mudanças da demanda. É a primeira
//    coleção que o CLIENTE escreve e que serve de registro, então as regras
//    fecham o que dá: autor = o do token, data = a do servidor, e nada de
//    update. O bloco tem a nota completa sobre até onde isso vale como prova.
//
// Nota sobre consultas: as telas sempre filtram por setor (`==` ou `in`), e o
// admin consulta DEFAULT_SECTORS. Por isso o escopo por setor na leitura não
// quebra nenhuma query existente.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function userEmail() {
      return request.auth.token.email;
    }
    // E-mail super admin (bootstrap). Trocar aqui se mudar o dono do sistema.
    function isSuperAdmin() {
      return isSignedIn() && userEmail() == 'setorbiunichristus@gmail.com';
    }
    function userPath() {
      return /databases/$(database)/documents/users/$(userEmail());
    }
    function hasProfile() {
      return isSignedIn() && exists(userPath());
    }
    function profile() {
      return get(userPath()).data;
    }
    function isActive() {
      return hasProfile() && profile().active == true;
    }
    function myRole() {
      return hasProfile() ? profile().role : 'none';
    }
    function isAdmin() {
      return isSuperAdmin() || (isActive() && myRole() == 'admin');
    }
    function isGestorOrAdmin() {
      return isAdmin() || (isActive() && myRole() == 'gestor');
    }
    // Autorizado a usar o sistema.
    function isAuthorized() {
      return isSuperAdmin() || isActive();
    }

    // Setores do usuário. O admin não depende disto — enxerga tudo.
    function mySectors() {
      return hasProfile() ? profile().get('sectors', []) : [];
    }
    function canSeeSector(s) {
      return isAdmin() || (s != '' && s in mySectors());
    }
    // Campo do doc existente / do doc enviado, tolerando ausência.
    function cur(field) {
      return resource.data.get(field, '');
    }
    function novo(field) {
      return request.resource.data.get(field, '');
    }
    function mudou(campos) {
      return request.resource.data.diff(resource.data)
               .affectedKeys().hasAny(campos);
    }
    // O doc de /users tem id em minúsculas, mas o e-mail do token vem do Google
    // como ele quiser. Comparar sem caixa evita negar criação por causa disso.
    function souEu(email) {
      return email.lower() == userEmail().lower();
    }

    // ---- usuários ----
    match /users/{userId} {
      allow read: if isSignedIn() && (userId == userEmail() || isAdmin());

      // Super admin cria o próprio doc (bootstrap); admin cria qualquer um.
      allow create: if isAdmin()
        || (isSuperAdmin() && userId == userEmail());

      // Admin edita todos; super admin edita o próprio; o dono pode atualizar
      // apenas campos de sessão (uid / lastLogin) do próprio doc.
      allow update: if isAdmin()
        || (isSuperAdmin() && userId == userEmail())
        || (userId == userEmail() && isActive()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['uid', 'lastLogin']));

      allow delete: if isAdmin();
    }

    // ---- preferências do próprio usuário ----
    // Subcoleção de propósito: o doc-pai só aceita ['uid','lastLogin'] do dono,
    // e abrir aquele hasOnly seria arriscar role/active/sectors por causa de
    // uma preferência de e-mail. O hasOnly aqui trava a FORMA do documento —
    // preferência é dado que o cliente escreve, então o schema é a defesa.
    // Regras v2 não cascateiam, então este bloco aninhado é obrigatório.
    match /users/{userId}/prefs/{docId} {
      allow read: if isSignedIn() && (souEu(userId) || isAdmin());
      allow write: if isSignedIn()
                   && souEu(userId)
                   && isActive()
                   && docId == 'relatorioGestor'
                   && request.resource.data.keys().hasOnly([
                        'v', 'tema', 'acento', 'densidade', 'setores', 'recorte',
                        'agrupamento', 'ordenacao', 'colunas', 'blocos',
                        'destinatariosPadrao', 'atualizadoEm'
                      ]);
    }

    // ---- setores ----
    match /sectors/{doc} {
      allow read: if isAuthorized();
      allow write: if isAdmin();
    }

    // ---- solicitantes e setores solicitantes ----
    // Qualquer usuário autorizado CRIA (no meio do preenchimento de uma
    // demanda: quem descobre que falta um solicitante é quem está cadastrando,
    // e mandá-lo pedir ao admin faz a demanda nascer sem solicitante).
    // Alterar e APAGAR continuam de admin: remover um solicitante em uso
    // deixaria cards apontando para um nome que não existe mais, e essa decisão
    // precisa de quem enxerga o cadastro inteiro.
    match /solicitantes/{doc} {
      allow read: if isAuthorized();
      allow create: if isAuthorized() && novo('name') != '';
      allow update, delete: if isAdmin();
    }
    match /solicitanteSetores/{doc} {
      allow read: if isAuthorized();
      allow create: if isAuthorized() && novo('name') != '';
      allow update, delete: if isAdmin();
    }

    // ---- recorrências (manutenção programada por setor) ----
    // A REGRA é do setor: quem enxerga o setor lê; gestor e admin escrevem.
    // Operador não edita o plano de manutenção — ele executa o card que nasce
    // dele, e mudar o ritmo é decisão de quem responde pelo setor.
    match /recorrencias/{doc} {
      allow read: if isAuthorized() && canSeeSector(cur('sector'));
      allow create: if isGestorOrAdmin()
                    && canSeeSector(novo('sector'))
                    && novo('name') != ''
                    && novo('sector') != '';
      allow update: if isGestorOrAdmin()
                    && canSeeSector(cur('sector'))
                    && canSeeSector(novo('sector'));
      allow delete: if isGestorOrAdmin() && canSeeSector(cur('sector'));
    }

    // ---- ocorrências (a data prevista que já virou card) ----
    // Só leitura do cliente. Quem escreve é a rota /api/recorrencias/gerar,
    // pelo Admin SDK: é ela que garante um card por data, dentro de uma
    // transação. Deixar o navegador criar ocorrência devolveria a duplicata
    // que a transação existe para impedir.
    match /ocorrencias/{doc} {
      allow read: if isAuthorized() && canSeeSector(cur('sector'));
      allow write: if false;
    }

    // ---- colunas do kanban (por setor) ----
    match /columns/{doc} {
      allow read: if isAuthorized() && canSeeSector(cur('sector'));
      allow create: if isGestorOrAdmin() && canSeeSector(novo('sector'));
      allow update: if isGestorOrAdmin()
                    && canSeeSector(cur('sector'))
                    && novo('sector') == cur('sector');
      allow delete: if isGestorOrAdmin() && canSeeSector(cur('sector'));
    }

    // ---- cards / demandas ----
    match /cards/{doc} {
      allow read: if isAuthorized() && canSeeSector(cur('sector'));

      allow create: if isAuthorized()
                    && canSeeSector(novo('sector'))
                    && souEu(novo('createdBy'));

      // `sector` e `createdBy` imutáveis: trocar o setor por update seria a
      // porta dos fundos para escrever em quadro alheio.
      allow update: if isAuthorized()
                    && canSeeSector(cur('sector'))
                    && novo('sector') == cur('sector')
                    && novo('createdBy').lower() == cur('createdBy').lower();

      // Apagar demanda é ação de gestor, e só no próprio setor.
      allow delete: if isGestorOrAdmin() && canSeeSector(cur('sector'));
    }

    // ---- histórico da demanda ----
    // A trilha de mudanças que o card mostra no canto superior direito. Regras
    // v2 não cascateiam, então este bloco é obrigatório mesmo estando dentro de
    // /cards.
    //
    // O que está fechado, e por quê:
    //  - `autor` TEM de ser o do token: ninguém registra em nome de outro.
    //  - `em` TEM de ser a hora do servidor (`serverTimestamp()` no cliente):
    //    sem isto, "quando" seria o relógio do navegador de quem escreveu, e um
    //    evento poderia nascer datado de mês passado.
    //  - `update` é NEGADO para todos. Evento gravado não se reescreve — um
    //    histórico editável responde a pergunta errada.
    //  - `hasOnly` trava a forma: dado que o cliente escreve tem o schema como
    //    defesa, mesmo padrão de /users/{id}/prefs.
    //
    // O que NÃO está fechado, dito na cara: quem tem acesso ao setor pode criar
    // um evento descrevendo algo que não fez. Essa mesma pessoa poderia apenas
    // fazer a mudança de verdade, então a brecha não dá poder novo. Auditoria
    // à prova de insider é /logs, que só o servidor escreve.
    //
    // Ler e apagar olham o `sector` DO PRÓPRIO EVENTO, como em /cards — e por
    // isso as consultas do app filtram por setor (ver `historico.ts`). A
    // alternativa, perguntar o setor ao card pai com um `get()`, seria um
    // acesso a documento por evento avaliado: numa listagem de 100 eventos ou
    // numa varrida de exclusão, é o tipo de coisa que estoura o teto de
    // acessos das regras e derruba a tela inteira em vez de negar uma linha.
    //
    // Quem garante que esse `sector` é verdadeiro é a CRIAÇÃO, que acontece uma
    // vez por evento e pode pagar o `get()` com folga.
    match /cards/{doc}/historico/{evento} {
      function cardPai() {
        return /databases/$(database)/documents/cards/$(doc);
      }

      allow read: if isAuthorized() && canSeeSector(cur('sector'));

      allow create: if isAuthorized()
                    && canSeeSector(novo('sector'))
                    && souEu(novo('autor'))
                    && request.resource.data.em == request.time
                    && request.resource.data.keys()
                         .hasOnly(['sector', 'autor', 'em', 'acao', 'mudancas'])
                    && novo('acao') in ['criada', 'editada', 'movida']
                    // O card e o primeiro evento nascem no MESMO lote, e o pai
                    // ainda não existe para o `get()` — daí o primeiro braço.
                    // Depois disso, o setor do evento tem de ser o do card: é
                    // isto que impede um evento de se esconder num setor
                    // diferente do da demanda em que está pendurado.
                    && (!exists(cardPai())
                        || get(cardPai()).data.sector == novo('sector'));

      allow update: if false;

      // Só para a varrida de `apagarHistorico`, que roda antes de excluir a
      // demanda — mesma autoridade que já pode excluir o card inteiro.
      allow delete: if isGestorOrAdmin() && canSeeSector(cur('sector'));
    }

    // ---- reuniões ----
    match /meetings/{doc} {
      allow read: if isAuthorized() && canSeeSector(cur('sector'));

      allow create: if isAuthorized()
                    && canSeeSector(novo('sector'))
                    && souEu(novo('createdBy'));

      // O setor da reunião PODE mudar (o modal permite corrigir), mas o destino
      // também precisa ser um setor do usuário — senão daria para empurrar a
      // reunião para um quadro onde ele não entra.
      // driveOutputs/notifiedAt são do servidor: bloqueados aqui.
      allow update: if isAuthorized()
                    && canSeeSector(cur('sector'))
                    && canSeeSector(novo('sector'))
                    && novo('createdBy').lower() == cur('createdBy').lower()
                    && !mudou(['driveOutputs', 'notifiedAt']);

      allow delete: if isGestorOrAdmin() && canSeeSector(cur('sector'));
    }

    // ---- propostas de demanda geradas a partir de reuniões ----
    // O cliente NUNCA escreve aqui. Quem grava é o servidor: o ingest cria as
    // propostas, e `api/demandas/decidir` registra a decisão depois de checar
    // quem é o usuário. Deixar o cliente escrever abriria o caminho de forjar
    // uma proposta "aprovada" e transformá-la em card.
    match /demandPropostas/{doc} {
      allow read: if isAuthorized() && canSeeSector(cur('sectorAlvo'));
      allow write: if false;
    }
    match /demandLotes/{doc} {
      allow read: if isAuthorized() && canSeeSector(cur('sectorReuniao'));
      allow write: if false;
    }

    // ---- trilha de auditoria ----
    // Escrita só pelo servidor (Admin SDK ignora estas regras). Log que o
    // cliente pode forjar ou apagar não serve como log.
    match /logs/{doc} {
      allow read: if isGestorOrAdmin();
      allow create, update, delete: if false;
    }

    // Nega qualquer outro caminho não previsto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
