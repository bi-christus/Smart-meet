rules_version = '2';

// ============================================================================
// Smart Meeting — Regras de segurança do Firestore
//
// Modelo de acesso:
//  - Usuários são identificados pelo e-mail (doc id = e-mail em minúsculas).
//  - Só quem tem doc em /users com active == true (ou o super admin) usa o app.
//  - Papéis: admin > gestor > operador.
//  - O super admin (bootstrap) pode sempre gerenciar — cria o próprio doc no
//    primeiro acesso, resolvendo o problema do "primeiro admin".
//
// O QUE MUDOU (2026-08-03) e por quê:
//  - /cards e /meetings tinham `write: if isAuthorized()`. Qualquer operador
//    ativo apagava TODOS os cards de TODOS os setores pelo console, sem log.
//    Agora leitura e escrita são escopadas por setor, e apagar exige gestor.
//  - `sector` e `createdBy` de um card passam a ser imutáveis: mover card entre
//    setores por update era um jeito de contornar o escopo.
//  - `driveOutputs` e `notifiedAt` das reuniões só o servidor escreve (Admin
//    SDK ignora estas regras). Do cliente, ficam bloqueados — eram o caminho
//    para apagar os links da ata ou reenviar e-mail.
//  - /solicitantes e /solicitanteSetores ganharam regra própria: o app os usa
//    (Kanban lê, Admin gerencia) e a negação final os bloqueava.
//  - /logs deixa de aceitar escrita do cliente — auditoria forjável não serve
//    como auditoria. Quem grava é o servidor.
//
// O QUE MUDOU (2026-08-07):
//  - /recorrencias e /ocorrencias, da aba Recorrências. A regra é escopada por
//    setor e editável por gestor; a ocorrência (a data que já virou card) é
//    somente leitura no cliente, porque quem a cria é a rota de geração, numa
//    transação que garante um card por data prevista.
//
// O QUE MUDOU (2026-08-12):
//  - /cards/{id}/historico, a trilha de mudanças da demanda. É a primeira
//    coleção que o CLIENTE escreve e que serve de registro, então as regras
//    fecham o que dá: autor = o do token, data = a do servidor, e nada de
//    update. O bloco tem a nota completa sobre até onde isso vale como prova.
//
// O QUE MUDOU (2026-08-13):
//  - /users passa a ser LEGÍVEL por qualquer usuário ativo, e não só o próprio
//    doc e o do admin. Sete telas assinam a coleção INTEIRA para traduzir
//    e-mail em nome, e consulta de coleção é decidida antes de existir
//    documento: a regra antiga negava a consulta toda, e o operador via
//    "fulano@..." onde devia ler gente. O bloco abaixo diz o que isso expõe.
//  - As funções de autorização foram reescritas para LER O CADASTRO UMA VEZ.
//    Antes, uma exclusão de demanda custava 14 acessos a documento para um
//    gestor e 8 para um admin, contra um teto de 20 por lote — e por isso
//    apagar demanda só funcionava para o super admin, o único que é
//    reconhecido sem ler documento nenhum. O orçamento novo está comentado em
//    cima do bloco de funções, e é o número a conferir antes de acrescentar
//    qualquer `get()` numa regra.
//  - /cards ganhou a LIXEIRA (`deletedAt` / `deletedBy`). Excluir demanda
//    passou a ser um update, e update de card era liberado para qualquer
//    usuário ativo: sem a regra nova, um operador esvaziaria o quadro inteiro.
//    Mandar para a lixeira e restaurar exigem gestor ou admin — a mesma
//    autoridade que já podia apagar de vez. O histórico ganhou os verbos
//    `excluida` e `restaurada` para que a ida e a volta deixem rastro.
//
// Nota sobre consultas: as telas sempre filtram por setor (`==` ou `in`), e o
// admin consulta DEFAULT_SECTORS. Por isso o escopo por setor na leitura não
// quebra nenhuma query existente.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function userEmail() {
      return request.auth.token.email;
    }
    // E-mail super admin (bootstrap). Trocar aqui se mudar o dono do sistema.
    function isSuperAdmin() {
      return isSignedIn() && userEmail() == 'setorbiunichristus@gmail.com';
    }
    function userPath() {
      return /databases/$(database)/documents/users/$(userEmail());
    }
    // ================= ORÇAMENTO DE ACESSOS A DOCUMENTO =================
    // O número que a próxima pessoa precisa para não estourar de novo.
    //
    // As regras têm teto de 10 acessos a documento por operação e 20 por lote
    // ou transação. Estourar qualquer um dos dois devolve "sem permissão" para
    // quem TEM permissão — o erro não diz que foi o teto, ele diz que você não
    // podia. Custo de cada decisão, por papel, depois desta reescrita:
    //
    //   super admin ................. 0  (só lê o token; o || corta antes)
    //   usuário sem doc em /users ... 1  (o exists() nega, o get() nem acontece)
    //   admin / gestor / operador ... 2  (1 exists + 1 get, sempre)
    //   regra que olha DOIS setores . 4  (update de /recorrencias e /meetings)
    //   create em /historico ........ 4  (2 + exists/get do card pai)
    //
    // Antes eram 6 a 8 para ler um card e 14 para um gestor apagar um. Com o
    // teto de 20 por lote, isso bastava para o antigo `deleteCardById` — um
    // lote de até 400 deleções — negar a exclusão a todo mundo que não fosse o
    // super admin, o único que não lê documento nenhum para ser reconhecido.
    //
    // O desperdício era chamada repetida, não cálculo caro: `isGestorOrAdmin()`
    // chamava `isAdmin()`, `canSeeSector()` chamava `isAdmin()` DE NOVO, e
    // `isActive()`, `myRole()` e `mySectors()` liam o mesmo documento uma vez
    // cada. Função chamada duas vezes é avaliada duas vezes. A documentação
    // promete cache com "some document access calls MAY be cached", que não é
    // linguagem de garantia — então a economia daqui vem de CHAMAR MENOS, e o
    // projeto é para o pior caso, sem cache nenhum.
    //
    // A SAÍDA DEFINITIVA é custom claims: `role` e `sectors` assinados dentro
    // do JWT derrubam este custo a ZERO acesso, para todo papel. Exige uma rota
    // de servidor no login (Admin SDK, `setCustomUserClaims`) e um jeito de
    // forçar a renovação do token quando o admin muda o papel de alguém, senão
    // a permissão velha vale até o token expirar. Fora do escopo deste PR, mas
    // é para lá que isto vai.
    // =====================================================================

    // O `exists()` continua aqui de propósito — ele É o segundo acesso.
    //
    // Trocar `exists() + get()` por um `get()` só depende de saber o que o
    // `get()` devolve para documento que não existe: se for `null`, bastava
    // testar `!= null`; se for erro de avaliação, some a diferença entre "não
    // pode" e "quebrou". Em quase toda regra dá no mesmo, porque as duas
    // respostas negam. Só NÃO dá no mesmo em um lugar: a leitura do próprio doc
    // em /users, que é exatamente o que o login de quem AINDA NÃO TEM acesso
    // precisa fazer para receber "você não tem acesso" em vez de um erro de
    // permissão (ver `ensureUserProfile`). Lá a regra é `isAuthorized() || (é o
    // meu doc)`, e um erro no primeiro braço pode derrubar o segundo junto.
    //
    // Sem emulador não dá para verificar qual dos dois é (ele é um JAR e não há
    // Java neste ambiente — AGENTS.md §6), e o preço de errar é o login de todo
    // usuário novo. Um acesso a mais é mais barato que essa aposta.
    function temPerfil() {
      return isSignedIn() && exists(userPath());
    }

    // `papeis` vazio significa "qualquer papel serve": `isAuthorized()` nunca
    // olhou o papel, e um cadastro com o papel escrito errado não pode perder
    // por causa desta reescrita o acesso que tem hoje.
    //
    // `.get(campo, padrão)` em vez de `p.active`: ler chave ausente é erro de
    // avaliação, e erro dentro de um `||` é o tipo de coisa que ninguém prevê.
    // O padrão explícito nega, que é a resposta certa para cadastro incompleto.
    function perfilOk(papeis, exigeSetor, s) {
      // O `let` é o que garante UMA leitura: sem ele, cada pergunta sobre o
      // cadastro (ativo? papel? setores?) seria um `get()` novo — foi assim que
      // o custo de uma exclusão chegou a 14.
      let p = get(userPath()).data;
      let papel = p.get('role', '');
      return p.get('active', false) == true
             && (papeis.size() == 0 || papel in papeis)
             && (!exigeSetor
                 || papel == 'admin'
                 || (s != '' && s in p.get('sectors', [])));
    }

    // As perguntas de sempre, agora com UMA leitura do cadastro cada. O
    // `isSuperAdmin()` vem primeiro em todas porque ele responde sem ler
    // documento nenhum — é o bootstrap, e o único que funciona sem doc.
    function isAdmin() {
      return isSuperAdmin() || (temPerfil() && perfilOk(['admin'], false, ''));
    }
    function isGestorOrAdmin() {
      return isSuperAdmin()
             || (temPerfil() && perfilOk(['admin', 'gestor'], false, ''));
    }
    // Autorizado a usar o sistema.
    function isAuthorized() {
      return isSuperAdmin() || (temPerfil() && perfilOk([], false, ''));
    }
    // Sem o atalho do super admin, de propósito: é a regra de "o dono do doc
    // mexe no próprio doc", e o super admin sem cadastro não tem doc para mexer.
    function isActive() {
      return temPerfil() && perfilOk([], false, '');
    }

    // Autorização E setor na MESMA leitura. Antes eram duas perguntas
    // (`isAuthorized() && canSeeSector(s)`), e cada uma pagava a sua ida ao
    // banco; o admin ainda pagava a terceira, porque `canSeeSector` perguntava
    // "é admin?" outra vez. O admin enxerga todo setor — é o que o `papel ==
    // 'admin'` dentro de `perfilOk` preserva.
    function podeNoSetor(s) {
      return isSuperAdmin() || (temPerfil() && perfilOk([], true, s));
    }
    function gestorNoSetor(s) {
      return isSuperAdmin()
             || (temPerfil() && perfilOk(['admin', 'gestor'], true, s));
    }
    // Campo do doc existente / do doc enviado, tolerando ausência.
    function cur(field) {
      return resource.data.get(field, '');
    }
    function novo(field) {
      return request.resource.data.get(field, '');
    }
    function mudou(campos) {
      return request.resource.data.diff(resource.data)
               .affectedKeys().hasAny(campos);
    }
    // O doc de /users tem id em minúsculas, mas o e-mail do token vem do Google
    // como ele quiser. Comparar sem caixa evita negar criação por causa disso.
    function souEu(email) {
      return email.lower() == userEmail().lower();
    }

    // ---- usuários ----
    // A LEITURA é da coleção inteira, não do próprio doc, e isso é escolha.
    // `subscribeUsers` (src/lib/users.ts) assina /users em sete telas — Kanban,
    // Dashboard, Cronograma, Recorrências, Reuniões e os dois relatórios — só
    // para virar e-mail em nome e cor. Consulta de coleção no Firestore é
    // decidida sem conhecer documento nenhum: regra que depende do id nega a
    // consulta inteira, não os documentos de fora. Era isso, e não um bug de
    // tela, que fazia todo não-admin ver e-mail cru no lugar de gente.
    //
    // O que fica aberto, dito na cara: qualquer usuário ativo enxerga `role`,
    // `active`, `sectors`, `uid` e `lastLogin` de todo mundo. Vale aqui porque
    // isto é ferramenta interna e esses campos SÃO o organograma da equipe —
    // quem responde por qual setor o app já mostra no responsável de cada card
    // e no filtro do quadro. Não se expõe nada que a tela não exponha.
    //
    // A alternativa descartada foi uma coleção espelho /diretorio, só com nome
    // e cor: duas fontes de verdade para o mesmo nome, sincronização a manter
    // em toda edição de usuário e um backfill de todos os já cadastrados —
    // manutenção permanente para esconder um dado que a própria tela mostra.
    //
    // O segundo braço é para quem NÃO é autorizado: sem doc, ou com
    // `active: false`, `isAuthorized()` é falso, e é justamente esse doc que o
    // login precisa ler para responder "você não tem acesso" em vez de estourar
    // erro de permissão (ver `ensureUserProfile`). Não há recursão: `get()` e
    // `exists()` dentro das regras são leitura privilegiada, não passam por
    // elas de novo.
    //
    // Ele usa `souEu` e não `userId == userEmail()` porque o doc id é minúsculo
    // e o e-mail do token vem do Google na caixa que ele quiser. Comparar cru
    // negaria a leitura justo para quem mais depende dela: quem ainda não tem
    // acesso, e cujo login precisa ler o próprio doc para descobrir isso.
    match /users/{userId} {
      allow read: if isAuthorized() || (isSignedIn() && souEu(userId));

      // Super admin cria o próprio doc (bootstrap); admin cria qualquer um.
      allow create: if isAdmin()
        || (isSuperAdmin() && userId == userEmail());

      // Admin edita todos; super admin edita o próprio; o dono pode atualizar
      // apenas campos de sessão (uid / lastLogin) do próprio doc.
      allow update: if isAdmin()
        || (isSuperAdmin() && userId == userEmail())
        || (userId == userEmail() && isActive()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['uid', 'lastLogin']));

      allow delete: if isAdmin();
    }

    // ---- preferências do próprio usuário ----
    // Subcoleção de propósito: o doc-pai só aceita ['uid','lastLogin'] do dono,
    // e abrir aquele hasOnly seria arriscar role/active/sectors por causa de
    // uma preferência de e-mail. O hasOnly aqui trava a FORMA do documento —
    // preferência é dado que o cliente escreve, então o schema é a defesa.
    // Regras v2 não cascateiam, então este bloco aninhado é obrigatório.
    match /users/{userId}/prefs/{docId} {
      allow read: if isSignedIn() && (souEu(userId) || isAdmin());
      allow write: if isSignedIn()
                   && souEu(userId)
                   && isActive()
                   && docId == 'relatorioGestor'
                   && request.resource.data.keys().hasOnly([
                        'v', 'tema', 'acento', 'densidade', 'setores', 'recorte',
                        'agrupamento', 'ordenacao', 'colunas', 'blocos',
                        'destinatariosPadrao', 'atualizadoEm'
                      ]);
    }

    // ---- setores ----
    match /sectors/{doc} {
      allow read: if isAuthorized();
      allow write: if isAdmin();
    }

    // ---- solicitantes e setores solicitantes ----
    // Qualquer usuário autorizado CRIA (no meio do preenchimento de uma
    // demanda: quem descobre que falta um solicitante é quem está cadastrando,
    // e mandá-lo pedir ao admin faz a demanda nascer sem solicitante).
    // Alterar e APAGAR continuam de admin: remover um solicitante em uso
    // deixaria cards apontando para um nome que não existe mais, e essa decisão
    // precisa de quem enxerga o cadastro inteiro.
    match /solicitantes/{doc} {
      allow read: if isAuthorized();
      allow create: if isAuthorized() && novo('name') != '';
      allow update, delete: if isAdmin();
    }
    match /solicitanteSetores/{doc} {
      allow read: if isAuthorized();
      allow create: if isAuthorized() && novo('name') != '';
      allow update, delete: if isAdmin();
    }

    // ---- recorrências (manutenção programada por setor) ----
    // A REGRA é do setor: quem enxerga o setor lê; gestor e admin escrevem.
    // Operador não edita o plano de manutenção — ele executa o card que nasce
    // dele, e mudar o ritmo é decisão de quem responde pelo setor.
    match /recorrencias/{doc} {
      allow read: if podeNoSetor(cur('sector'));
      allow create: if gestorNoSetor(novo('sector'))
                    && novo('name') != ''
                    && novo('sector') != '';
      // Uma das duas regras que leem o cadastro duas vezes (4 acessos; a outra
      // é o update de /meetings): o setor PODE mudar, e origem e destino
      // precisam ser enxergados pelo mesmo usuário. Antes eram 12 acessos para
      // um admin e 20 para um gestor, contra um teto de 10 por operação.
      allow update: if gestorNoSetor(cur('sector'))
                    && gestorNoSetor(novo('sector'));
      allow delete: if gestorNoSetor(cur('sector'));
    }

    // ---- ocorrências (a data prevista que já virou card) ----
    // Só leitura do cliente. Quem escreve é a rota /api/recorrencias/gerar,
    // pelo Admin SDK: é ela que garante um card por data, dentro de uma
    // transação. Deixar o navegador criar ocorrência devolveria a duplicata
    // que a transação existe para impedir.
    match /ocorrencias/{doc} {
      allow read: if podeNoSetor(cur('sector'));
      allow write: if false;
    }

    // ---- colunas do kanban (por setor) ----
    match /columns/{doc} {
      allow read: if podeNoSetor(cur('sector'));
      allow create: if gestorNoSetor(novo('sector'));
      allow update: if gestorNoSetor(cur('sector'))
                    && novo('sector') == cur('sector');
      allow delete: if gestorNoSetor(cur('sector'));
    }

    // ---- cards / demandas ----
    // A LIXEIRA mora em dois campos do próprio card: `deletedAt` (ms) e
    // `deletedBy` (e-mail). Ausente ou `null` = demanda viva. Isso faz da
    // exclusão um UPDATE, e sem o que está escrito abaixo ela cairia no
    // `allow update: if isAuthorized()` de antes — qualquer operador ativo
    // esvaziaria o quadro inteiro carimbando `deletedAt`, sem passar por
    // nenhuma regra de gestor e sem deixar de ser, para o Firestore, uma edição
    // comum de demanda.
    match /cards/{doc} {
      // Quem carimba a exclusão tem de ser quem está escrevendo — mesmo
      // princípio de `createdBy` e do `autor` do histórico: ninguém manda para
      // a lixeira em nome de outro.
      //
      // `null` passa porque `null` é o que a restauração grava (ver
      // `restaurarDaLixeira` em `kanban.ts`): a marca sai virando null, e não
      // sumindo do documento, justamente para que esta regra tenha um valor
      // para examinar.
      //
      // O `!mudou(['deletedBy'])` na frente não é folga, é o caso comum. Num
      // update, `request.resource.data` é o documento RESULTANTE, não o patch:
      // uma demanda que está na lixeira carrega o `deletedBy` de quem a mandou
      // para lá em toda escrita seguinte. Sem essa guarda, qualquer edição de
      // uma demanda excluída — inclusive a correção de tags que o quadro faz
      // sozinho em lote — passaria a ser negada para todo mundo, menos para a
      // pessoa que excluiu.
      function deletedByEhDoToken() {
        let quem = request.resource.data.get('deletedBy', null);
        return !mudou(['deletedBy']) || quem == null || souEu(quem);
      }

      allow read: if podeNoSetor(cur('sector'));

      allow create: if podeNoSetor(novo('sector'))
                    && souEu(novo('createdBy'));

      // `sector` e `createdBy` imutáveis: trocar o setor por update seria a
      // porta dos fundos para escrever em quadro alheio.
      //
      // O ternário no fim é o que decide QUEM pode: update que mexe em
      // `deletedAt` ou `deletedBy` é ida para a lixeira ou volta dela, e exige
      // a mesma autoridade que já podia apagar de vez; qualquer outro update
      // continua sendo edição comum, de qualquer usuário ativo do setor. É
      // ternário e não `isAuthorized() && (!mudou(...) || isGestorOrAdmin())`
      // porque só um dos dois braços é avaliado: a edição do operador — o
      // update mais frequente do app — continua custando UMA leitura do
      // cadastro, e não duas.
      //
      // As comparações que não custam acesso a documento vêm primeiro de
      // propósito: um update recusado por mexer no setor é recusado sem ler
      // nada do banco.
      allow update: if novo('sector') == cur('sector')
                    && novo('createdBy').lower() == cur('createdBy').lower()
                    && deletedByEhDoToken()
                    && (mudou(['deletedAt', 'deletedBy'])
                        ? gestorNoSetor(cur('sector'))
                        : podeNoSetor(cur('sector')));

      // Apagar de vez continua sendo ação de gestor, e só no próprio setor.
      // O expurgo da lixeira roda no servidor (`api/demandas/expurgar`, Admin
      // SDK, que ignora estas regras) porque precisa varrer a subcoleção de
      // histórico junto — mas afrouxar aqui abriria a exclusão definitiva pelo
      // console para qualquer um, sem passar pelo servidor.
      allow delete: if gestorNoSetor(cur('sector'));
    }

    // ---- histórico da demanda ----
    // A trilha de mudanças que o card mostra no canto superior direito. Regras
    // v2 não cascateiam, então este bloco é obrigatório mesmo estando dentro de
    // /cards.
    //
    // O que está fechado, e por quê:
    //  - `autor` TEM de ser o do token: ninguém registra em nome de outro.
    //  - `em` TEM de ser a hora do servidor (`serverTimestamp()` no cliente):
    //    sem isto, "quando" seria o relógio do navegador de quem escreveu, e um
    //    evento poderia nascer datado de mês passado.
    //  - `update` é NEGADO para todos. Evento gravado não se reescreve — um
    //    histórico editável responde a pergunta errada.
    //  - `hasOnly` trava a forma: dado que o cliente escreve tem o schema como
    //    defesa, mesmo padrão de /users/{id}/prefs.
    //
    // O que NÃO está fechado, dito na cara: quem tem acesso ao setor pode criar
    // um evento descrevendo algo que não fez. Essa mesma pessoa poderia apenas
    // fazer a mudança de verdade, então a brecha não dá poder novo. Auditoria
    // à prova de insider é /logs, que só o servidor escreve.
    //
    // Ler e apagar olham o `sector` DO PRÓPRIO EVENTO, como em /cards — e por
    // isso as consultas do app filtram por setor (ver `historico.ts`). A
    // alternativa, perguntar o setor ao card pai com um `get()`, seria um
    // acesso a documento por evento avaliado: numa listagem de 100 eventos ou
    // numa varrida de exclusão, é o tipo de coisa que estoura o teto de
    // acessos das regras e derruba a tela inteira em vez de negar uma linha.
    //
    // Quem garante que esse `sector` é verdadeiro é a CRIAÇÃO, que acontece uma
    // vez por evento e pode pagar o `get()` com folga.
    match /cards/{doc}/historico/{evento} {
      function cardPai() {
        return /databases/$(database)/documents/cards/$(doc);
      }

      allow read: if podeNoSetor(cur('sector'));

      // `excluida` e `restaurada` são a lixeira: a ida e a volta precisam
      // deixar rastro, senão a demanda some do quadro sem nada responder quem a
      // tirou de lá. A lista é fechada de propósito — verbo que a tela não sabe
      // rotular vira linha muda no histórico (ver `ACAO_ROTULO`).
      allow create: if podeNoSetor(novo('sector'))
                    && souEu(novo('autor'))
                    && request.resource.data.em == request.time
                    && request.resource.data.keys()
                         .hasOnly(['sector', 'autor', 'em', 'acao', 'mudancas'])
                    && novo('acao') in ['criada', 'editada', 'movida',
                                        'excluida', 'restaurada']
                    // O card e o primeiro evento nascem no MESMO lote, e o pai
                    // ainda não existe para o `get()` — daí o primeiro braço.
                    // Depois disso, o setor do evento tem de ser o do card: é
                    // isto que impede um evento de se esconder num setor
                    // diferente do da demanda em que está pendurado.
                    && (!exists(cardPai())
                        || get(cardPai()).data.sector == novo('sector'));

      allow update: if false;

      // Mesma autoridade que já pode excluir o card inteiro. A varrida da
      // subcoleção saiu do cliente e virou `api/demandas/expurgar` (Admin SDK),
      // porque um lote de até 400 deleções não cabe no teto de 20 acessos a
      // documento por lote — era esse teto, e não falta de permissão, que
      // negava a exclusão a admin e gestor.
      allow delete: if gestorNoSetor(cur('sector'));
    }

    // ---- reuniões ----
    match /meetings/{doc} {
      allow read: if podeNoSetor(cur('sector'));

      allow create: if podeNoSetor(novo('sector'))
                    && souEu(novo('createdBy'));

      // O setor da reunião PODE mudar (o modal permite corrigir), mas o destino
      // também precisa ser um setor do usuário — senão daria para empurrar a
      // reunião para um quadro onde ele não entra.
      // driveOutputs/notifiedAt são do servidor: bloqueados aqui.
      allow update: if podeNoSetor(cur('sector'))
                    && podeNoSetor(novo('sector'))
                    && novo('createdBy').lower() == cur('createdBy').lower()
                    && !mudou(['driveOutputs', 'notifiedAt']);

      allow delete: if gestorNoSetor(cur('sector'));
    }

    // ---- propostas de demanda geradas a partir de reuniões ----
    // O cliente NUNCA escreve aqui. Quem grava é o servidor: o ingest cria as
    // propostas, e `api/demandas/decidir` registra a decisão depois de checar
    // quem é o usuário. Deixar o cliente escrever abriria o caminho de forjar
    // uma proposta "aprovada" e transformá-la em card.
    match /demandPropostas/{doc} {
      allow read: if podeNoSetor(cur('sectorAlvo'));
      allow write: if false;
    }
    match /demandLotes/{doc} {
      allow read: if podeNoSetor(cur('sectorReuniao'));
      allow write: if false;
    }

    // ---- trilha de auditoria ----
    // Escrita só pelo servidor (Admin SDK ignora estas regras). Log que o
    // cliente pode forjar ou apagar não serve como log.
    match /logs/{doc} {
      allow read: if isGestorOrAdmin();
      allow create, update, delete: if false;
    }

    // Nega qualquer outro caminho não previsto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
